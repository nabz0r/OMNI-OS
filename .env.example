# This file contains no credentials. run.sh creates private local credentials.
OMNI_CORE_PORT=3007
OMNI_COLLECTOR_PORT=3008
OMNI_LLM_BASE=http://127.0.0.1:11434/v1
OMNI_LLM_MODEL=qwen3:0.6b
# Separate loopback-only model for capture-to-memory proposals.
OMNI_EXTRACTOR_BASE=http://127.0.0.1:11434/v1
OMNI_EXTRACTOR_MODEL=qwen3:0.6b
OMNI_ANALYTICS_OPT_IN=false
OMNI_ANALYTICS_URL=http://127.0.0.1:3008/api/v1/analytics
# Required for production collection; development SQLite storage is local only.
# REDIS_URL=redis://127.0.0.1:6379
OMNI_MIN_REPORTS=10000
# Import generated VPN enrollment separately: rotation_seconds defaults to 1800.
# After starting the VPN client, fail closed for remote provider connections:
# OMNI_SOCKS_PROXY=socks5h://10.77.0.1:1080
# OMNI_VPN_REQUIRED=true
